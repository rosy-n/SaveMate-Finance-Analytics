# Server
PORT=8080

# PostgreSQL (Neon) 연결 문자열 - Neon 콘솔의 Connect 에서 복사
# 앱(서버)이 쓰는 풀러 경유 연결
DATABASE_URL=postgresql://USER:PASSWORD@HOST-pooler/DBNAME?sslmode=require
# 마이그레이션(npm run migrate)이 쓰는 직접 연결
DATABASE_URL_UNPOOLED=postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require

# Google Gemini (https://aistudio.google.com/apikey 에서 각자 발급)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

# 로그인 토큰(JWT) 서명 키 - 임의의 긴 랜덤 문자열로 각자 생성해서 사용
# 생성 예: openssl rand -hex 48
JWT_SECRET=
